# ============================================================
# JARVIS configuration
# Copy this file to .env and edit. Never commit .env.
# ============================================================

# --- Backend -------------------------------------------------
# Bind to 127.0.0.1 for safety. Only change this if you understand
# the risk of exposing the desktop control service on your LAN.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Where JARVIS stores its SQLite database and app shortcut config.
# JARVIS_DATA_DIR=C:\Users\YourName\JARVIS\data

# Where generated files (presentations, projects, images) are written.
# JARVIS_OUTPUT_DIR=C:\Users\YourName\JARVIS

# Restricted root for generated code projects.
# JARVIS_PROJECT_ROOT=C:\Users\YourName\JARVIS\projects

# Extra folders JARVIS is allowed to read (semicolon separated).
# JARVIS_EXTRA_ROOTS=C:\Users\YourName\Downloads

# --- Local AI (Ollama) --------------------------------------
# Install from https://ollama.com then: ollama pull qwen2.5:3b
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen2.5:3b
JARVIS_OLLAMA_TIMEOUT=60

# --- Cloud AI (optional, OpenAI-compatible API) -------------
# Leave blank to stay fully local. Example: OpenRouter, Groq, OpenAI.
JARVIS_CLOUD_BASE_URL=
JARVIS_CLOUD_API_KEY=
JARVIS_CLOUD_MODEL=

# --- Image generation (optional) ----------------------------
# local  = AUTOMATIC1111 / SD WebUI API  (http://127.0.0.1:7860)
# openai = OpenAI-compatible /images/generations endpoint (needs key)
# none   = disabled
JARVIS_IMAGE_PROVIDER=none
JARVIS_IMAGE_BASE_URL=http://127.0.0.1:7860
JARVIS_IMAGE_API_KEY=
JARVIS_IMAGE_MODEL=

# --- Voice ---------------------------------------------------
# Backend STT is only available if faster-whisper is installed
# (see docs/INSTALLATION.md). The UI otherwise uses the browser's
# built-in speech recognition.
JARVIS_STT_MODEL=base.en
JARVIS_STT_DEVICE=cpu

# --- Behaviour ----------------------------------------------
# Auto-confirm moderate-risk actions (never applies to high risk).
JARVIS_AUTO_CONFIRM_MODERATE=false
# Store task history locally.
JARVIS_TASK_HISTORY=true
